          "200": {
            "description": "Успешный вход, JWT в теле ответа",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Неверный логин или пароль"
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerUser",
        "summary": "Регистрация пользователя",
