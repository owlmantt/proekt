  <footer class="max-w-6xl mx-auto px-6 py-8 text-dim text-xs">
    Reads live from the local ChromaDB collection at <code class="font-mono">./chroma_db</code> — nothing on this page is mock data.
  </footer>

<script>
  const ROLES = [
    { id: 'all', label: 'All' },
    { id: 'frontend', label: 'Frontend' },
    { id: 'flutter', label: 'Flutter' },
    { id: 'backend', label: 'Backend' },
    { id: 'devops', label: 'DevOps' },
  ];

  const KIND_COLORS = {
    function: '#9135ff',
    class: '#47bfff',
    method: '#ffb454',
    constant: '#948da8',
    module: '#5b5470',
    file: '#5b5470',
    json: '#948da8',
    json_key: '#ffb454',
    section: '#47bfff',
    openapi_info: '#35d399',
    openapi_endpoint: '#35d399',
    openapi_schema: '#2fae86',
  };

  function kindColor(kind) {
    return KIND_COLORS[kind] || '#5b5470';
  }

  let activeRole = 'all';

  function renderRolePills() {
    const container = document.getElementById('role-pills');
    container.innerHTML = '';
    ROLES.forEach(role => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = role.label;
      btn.dataset.role = role.id;
      btn.dataset.active = String(role.id === activeRole);
      btn.className = 'role-pill text-xs font-medium px-3 py-1.5 rounded-md text-dim border border-transparent';
      btn.addEventListener('click', () => {
        activeRole = role.id;
        renderRolePills();
        if (document.getElementById('query').value.trim()) {
          runSearch();
        }
      });
      container.appendChild(btn);
    });
  }

  function escapeHtml(str) {
    return (str || '').replace(/[&<>"']/g, ch => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch]));
  }

  function renderResults(data) {
    const el = document.getElementById('results');
    const meta = document.getElementById('search-meta');

    if (!data.results.length) {
      meta.textContent = `0 results for "${data.query}" (${data.role})`;
      el.innerHTML = `
        <div class="text-dim text-sm border border-dashed border-line rounded-xl px-4 py-10 text-center">
          No chunks matched "${escapeHtml(data.query)}" for role "${data.role}". Try another query or role.
        </div>`;
      return;
    }

    meta.textContent = `${data.count} result${data.count === 1 ? '' : 's'} for "${data.query}" — role: ${data.role}`;

    el.innerHTML = data.results.map(hit => {
      const color = kindColor(hit.kind);
      const loc = hit.start_line
        ? `${hit.path}:${hit.start_line}${hit.end_line ? '-' + hit.end_line : ''}`
        : hit.path;
      const httpBadge = (hit.http_method && hit.api_path)
        ? `<span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-green/10 text-green border border-green/30 ml-2">${escapeHtml(hit.http_method)} ${escapeHtml(hit.api_path)}</span>`
        : '';
      const score = hit.rrf_score != null ? `rrf ${hit.rrf_score.toFixed(4)}` : '';

      return `
        <article class="bg-surface border border-line rounded-xl overflow-hidden" style="border-left: 3px solid ${color}">
          <div class="flex items-center justify-between gap-3 px-4 pt-3">
            <div class="flex items-center gap-2 min-w-0">
              <span class="kind-dot" style="background:${color}"></span>
              <span class="text-xs font-mono text-dim truncate">${escapeHtml(loc)}</span>
              ${httpBadge}
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class="text-[11px] font-mono uppercase tracking-wide" style="color:${color}">${escapeHtml(hit.kind || 'chunk')}</span>
            </div>
          </div>
          <div class="px-4 pt-1.5 pb-1 text-sm font-medium text-ink/90">${escapeHtml(hit.name || '')}</div>
          <pre class="snippet text-xs font-mono text-ink/80 bg-surface2 mx-4 mb-4 mt-2 p-3 rounded-lg overflow-x-auto max-h-56">${escapeHtml(hit.document)}</pre>
          <div class="px-4 pb-3 -mt-2 text-[11px] text-dim font-mono">${score}</div>
        </article>
      `;
    }).join('');
  }

  async function runSearch() {
    const query = document.getElementById('query').value.trim();
    const limit = parseInt(document.getElementById('limit').value, 10);
    const meta = document.getElementById('search-meta');
    if (!query) return;

    meta.textContent = 'searching…';
    try {
      const res = await fetch('/api/search', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, role: activeRole, limit }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      renderResults(data);
    } catch (err) {
      meta.textContent = `Search failed: ${err.message}. Is the server running?`;
    }
  }

  async function loadStats() {
    const statusDot = document.getElementById('status-dot');
    const statusText = document.getElementById('status-text');
    try {
      const res = await fetch('/api/stats');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      document.getElementById('stat-files').textContent = data.files_indexed;
      document.getElementById('stat-chunks').textContent = data.chunks_indexed;

      const kindsEntries = Object.entries(data.kinds || {});
      document.getElementById('stat-top-kind').textContent = kindsEntries.length ? kindsEntries[0][0] : '—';

      statusText.textContent = data.status;
      statusDot.classList.remove('pulse');
      statusDot.style.background = data.status === 'ok' ? '#35d399' : (data.status === 'empty' ? '#ffb454' : '#ff6b6b');

      const breakdown = document.getElementById('kind-breakdown');
      if (!kindsEntries.length) {
        breakdown.innerHTML = '<div class="text-dim">No chunks indexed yet.</div>';
      } else {
        const max = Math.max(...kindsEntries.map(([, c]) => c));
        breakdown.innerHTML = kindsEntries.map(([kind, count]) => {
          const color = kindColor(kind);
          const pct = Math.max(6, Math.round((count / max) * 100));
          return `
            <div>
              <div class="flex items-center justify-between text-dim mb-1">
                <span style="color:${color}" class="font-mono">${escapeHtml(kind)}</span>
                <span class="font-mono">${count}</span>
              </div>
              <div class="h-1.5 rounded-full bg-surface2 overflow-hidden">
                <div class="h-full rounded-full" style="width:${pct}%; background:${color}"></div>
              </div>
            </div>`;
        }).join('');
      }
    } catch (err) {
      statusText.textContent = 'unreachable';
      statusDot.classList.remove('pulse');
      statusDot.style.background = '#ff6b6b';
    }
  }

  document.getElementById('search-form').addEventListener('submit', (e) => {
    e.preventDefault();
    runSearch();
  });

  document.getElementById('mcp-url').textContent = `${window.location.origin}/mcp/sse`;

  document.getElementById('copy-btn').addEventListener('click', async () => {
    const text = document.getElementById('mcp-url').textContent;
    try {
      await navigator.clipboard.writeText(text);
      const row = document.getElementById('mcp-url-row');
      row.classList.add('copy-flash');
      setTimeout(() => row.classList.remove('copy-flash'), 500);
    } catch (e) { /* clipboard unavailable, ignore silently */ }
  });

  renderRolePills();
  loadStats();
  setInterval(loadStats, 15000);
</script>
</body>
