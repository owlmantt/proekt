    </section>

    <!-- Stats -->
    <section class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-6">
      <div class="bg-surface border border-line rounded-xl px-4 py-3">
        <div class="text-dim text-xs">Files indexed</div>
        <div id="stat-files" class="text-2xl font-semibold mt-1 font-mono">—</div>
      </div>
      <div class="bg-surface border border-line rounded-xl px-4 py-3">
        <div class="text-dim text-xs">Chunks indexed</div>
        <div id="stat-chunks" class="text-2xl font-semibold mt-1 font-mono">—</div>
      </div>
      <div class="bg-surface border border-line rounded-xl px-4 py-3">
        <div class="text-dim text-xs">Database status</div>
        <div id="stat-status" class="text-2xl font-semibold mt-1 flex items-center gap-2">
          <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-dim pulse"></span>
          <span id="status-text" class="font-mono text-base">checking</span>
        </div>
      </div>
      <div class="bg-surface border border-line rounded-xl px-4 py-3">
        <div class="text-dim text-xs">Top chunk type</div>
        <div id="stat-top-kind" class="text-2xl font-semibold mt-1 font-mono">—</div>
      </div>
    </section>

    <!-- Results + sidebar -->
    <section class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-6 mt-8 items-start">

      <!-- Results -->
      <div id="results" class="flex flex-col gap-3 min-h-[200px]">
        <div class="text-dim text-sm border border-dashed border-line rounded-xl px-4 py-10 text-center">
          Run a search above — results come straight from the ChromaDB collection via hybrid (vector + BM25) search.
        </div>
      </div>

      <!-- Sidebar -->
      <div class="flex flex-col gap-4 lg:sticky lg:top-6">

        <!-- MCP credentials -->
        <div class="bg-surface border border-line rounded-xl overflow-hidden">
          <div class="px-4 py-3 border-b border-line">
            <div class="text-sm font-medium">MCP connection</div>
            <div class="text-xs text-dim mt-0.5">For Cursor, Claude, or VS Code</div>
          </div>
          <div class="p-4 flex flex-col gap-3">
            <div>
              <div class="text-[11px] text-dim mb-1.5">SSE endpoint</div>
              <div id="mcp-url-row" class="flex items-center gap-2 bg-surface2 border border-line rounded-lg px-3 py-2">
                <code id="mcp-url" class="text-xs font-mono text-cyan truncate flex-1">http://localhost:8000/mcp/sse</code>
                <button id="copy-btn" class="text-xs text-dim hover:text-ink transition shrink-0" title="Copy">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <rect x="9" y="9" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.6"/>
                    <path d="M5 15V5a2 2 0 0 1 2-2h10" stroke="currentColor" stroke-width="1.6"/>
                  </svg>
                </button>
              </div>
            </div>
            <div>
              <div class="text-[11px] text-dim mb-1.5">Transport</div>
              <div class="text-xs font-mono text-ink/80">Server-Sent Events (SSE)</div>
            </div>
            <div>
              <div class="text-[11px] text-dim mb-1.5">Tools exposed</div>
              <div class="text-xs text-dim leading-relaxed">
                search_code · list_files · list_symbols · get_symbol · get_file_outline ·
                read_source · get_chunk_at_line · get_neighbors · grep_code ·
                find_references · list_api_endpoints · get_api_endpoint ·
                get_openapi_schema · index_stats
              </div>
            </div>
          </div>
        </div>

        <!-- Kind breakdown -->
        <div class="bg-surface border border-line rounded-xl p-4">
          <div class="text-sm font-medium mb-3">Chunk types</div>
          <div id="kind-breakdown" class="flex flex-col gap-2 text-xs">
