"""Гибридный поиск: векторный Chroma + BM25, слияние через Reciprocal Rank Fusion."""

from __future__ import annotations

import math
import re
from collections import Counter, defaultdict

TOKEN_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_]*|\d+")


def tokenize(text: str) -> list[str]:
    tokens = TOKEN_RE.findall(text)
    result: list[str] = []
    for token in tokens:
        result.append(token.lower())
        if token != token.lower():
            result.append(token)
    return result


class BM25Index:
    def __init__(self, documents: list[str], k1: float = 1.5, b: float = 0.75) -> None:
        self.k1 = k1
        self.b = b
        self.docs = [tokenize(doc) for doc in documents]
        self.doc_len = [len(doc) or 1 for doc in self.docs]
        self.avgdl = sum(self.doc_len) / len(self.doc_len) if self.doc_len else 1.0
        self.doc_freqs: list[Counter[str]] = [Counter(doc) for doc in self.docs]
        self.df: Counter[str] = Counter()
        for freq in self.doc_freqs:
            self.df.update(freq.keys())
        self.n = len(self.docs)

    def scores(self, query: str) -> list[float]:
        q_tokens = tokenize(query)
        if not q_tokens or self.n == 0:
            return [0.0] * self.n

        scores = [0.0] * self.n
        for token in set(q_tokens):
            df = self.df.get(token, 0)
            if df == 0:
                continue
            idf = math.log(1 + (self.n - df + 0.5) / (df + 0.5))
            for i, freq in enumerate(self.doc_freqs):
                tf = freq.get(token, 0)
                if tf == 0:
                    continue
                denom = tf + self.k1 * (1 - self.b + self.b * self.doc_len[i] / self.avgdl)
                scores[i] += idf * (tf * (self.k1 + 1)) / denom
        return scores


def reciprocal_rank_fusion(
    ranked_lists: list[list[str]],
    k: int = 60,
) -> list[tuple[str, float]]:
    scores: dict[str, float] = defaultdict(float)
    for ranked in ranked_lists:
        for rank, doc_id in enumerate(ranked, start=1):
            scores[doc_id] += 1.0 / (k + rank)
    return sorted(scores.items(), key=lambda item: item[1], reverse=True)


def hybrid_search(
    collection,
    query: str,
    limit: int = 3,
    candidate_multiplier: int = 8,
) -> list[dict]:
    raw = collection.get(include=["documents", "metadatas"])
    ids: list[str] = raw.get("ids") or []
    documents: list[str] = raw.get("documents") or []
    metadatas: list[dict] = raw.get("metadatas") or []

    if not ids:
        return []

    by_id = {
        doc_id: {"id": doc_id, "document": documents[i], "metadata": metadatas[i] or {}}
        for i, doc_id in enumerate(ids)
    }

    fetch_n = min(len(ids), max(limit * candidate_multiplier, limit))
    vector = collection.query(query_texts=[query], n_results=fetch_n)
    vector_ids: list[str] = []
    vector_distances: dict[str, float] = {}
    if vector.get("ids") and vector["ids"][0]:
        vector_ids = vector["ids"][0]
        distances = (vector.get("distances") or [[]])[0]
        for i, doc_id in enumerate(vector_ids):
            if i < len(distances):
                vector_distances[doc_id] = distances[i]

    bm25 = BM25Index(documents)
    bm25_scores = bm25.scores(query)
    bm25_ranked = [
        doc_id
        for doc_id, _score in sorted(
            zip(ids, bm25_scores),
            key=lambda item: item[1],
            reverse=True,
        )
        if _score > 0
    ]

    fused = reciprocal_rank_fusion([vector_ids, bm25_ranked])
    results: list[dict] = []
    for doc_id, rrf_score in fused[:limit]:
        item = dict(by_id[doc_id])
        item["rrf_score"] = rrf_score
        item["vector_distance"] = vector_distances.get(doc_id)
        results.append(item)
    return results
